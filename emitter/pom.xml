<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>br.unb.cic</groupId>
        <artifactId>td20</artifactId>
        <version>0.1.0-SNAPSHOT</version>
    </parent>
    <artifactId>emitter</artifactId>

    <properties>
        <exec.mainClass>br.unb.cic.td20.WitnessEmitter</exec.mainClass>
        <td20.gpuDevices>0</td20.gpuDevices>
        <td20.gpuSlots>7</td20.gpuSlots>
        <td20.gpuBudgetMB>1024</td20.gpuBudgetMB>
        <td20.gpuQueueCapacity></td20.gpuQueueCapacity>
        <td20.gpuStatsPeriodSeconds>10</td20.gpuStatsPeriodSeconds>
        <td20.cpuPrefixJvmArgument></td20.cpuPrefixJvmArgument>
        <td20.cpuPrefixMaxTriples>8192</td20.cpuPrefixMaxTriples>
        <td20.cpuPrefixMillis>10</td20.cpuPrefixMillis>
        <td20.reconstructionGpuWorkers></td20.reconstructionGpuWorkers>
        <td20.cpuStatsPeriodSeconds>${td20.gpuStatsPeriodSeconds}</td20.cpuStatsPeriodSeconds>
        <td20.twistedBraceletWorkers>auto</td20.twistedBraceletWorkers>
        <td20.certificateDb>${project.basedir}/../certificates</td20.certificateDb>
        <td20.certificateFlushSeconds>5</td20.certificateFlushSeconds>
        <td20.certificateQueueCapacity>16384</td20.certificateQueueCapacity>
        <td20.certificateLookupBatchSize>262144</td20.certificateLookupBatchSize>
        <td20.reconstructionBufferKeys>1048576</td20.reconstructionBufferKeys>
        <td20.args></td20.args>
    </properties>

    <dependencies>
        <dependency><groupId>org.rocksdb</groupId><artifactId>rocksdbjni</artifactId><classifier>linux64</classifier></dependency>
        <dependency><groupId>org.projectlombok</groupId><artifactId>lombok</artifactId><scope>provided</scope></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-api</artifactId></dependency>
        <dependency><groupId>org.slf4j</groupId><artifactId>slf4j-simple</artifactId></dependency>
        <dependency><groupId>org.junit.jupiter</groupId><artifactId>junit-jupiter</artifactId><scope>test</scope></dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.codehaus.mojo</groupId>
                <artifactId>exec-maven-plugin</artifactId>
                <executions>
                    <execution>
                        <id>cpu-cli</id>
                        <goals><goal>java</goal></goals>
                    </execution>
                    <execution>
                        <id>default-cli</id>
                        <goals><goal>exec</goal></goals>
                        <configuration>
                            <executable>java</executable>
                            <commandlineArgs>-classpath %classpath -Djava.library.path=${project.build.directory}/native -Dtd20.gpuDevices=${td20.gpuDevices} -Dtd20.gpuSlots=${td20.gpuSlots} -Dtd20.gpuBudgetMB=${td20.gpuBudgetMB} -Dtd20.gpuQueueCapacity=${td20.gpuQueueCapacity} -Dtd20.gpuStatsPeriodSeconds=${td20.gpuStatsPeriodSeconds} ${td20.cpuPrefixJvmArgument} -Dtd20.cpuPrefixMaxTriples=${td20.cpuPrefixMaxTriples} -Dtd20.cpuPrefixMillis=${td20.cpuPrefixMillis} -Dtd20.reconstructionGpuWorkers=${td20.reconstructionGpuWorkers} -Dtd20.cpuStatsPeriodSeconds=${td20.cpuStatsPeriodSeconds} -Dtd20.twistedBraceletWorkers=${td20.twistedBraceletWorkers} -Dtd20.certificateDb=${td20.certificateDb} -Dtd20.certificateFlushSeconds=${td20.certificateFlushSeconds} -Dtd20.certificateQueueCapacity=${td20.certificateQueueCapacity} -Dtd20.certificateLookupBatchSize=${td20.certificateLookupBatchSize} -Dtd20.reconstructionBufferKeys=${td20.reconstructionBufferKeys} ${exec.mainClass} ${td20.args}</commandlineArgs>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-surefire-plugin</artifactId>
                <configuration>
                    <argLine>-Djava.library.path=${project.build.directory}/native</argLine>
                </configuration>
            </plugin>
        </plugins>
    </build>

    <profiles>
        <profile>
            <id>cpu-prefix-depth</id>
            <activation>
                <property><name>td20.cpuPrefixDepth</name></property>
            </activation>
            <properties>
                <td20.cpuPrefixJvmArgument>-Dtd20.cpuPrefixDepth=${td20.cpuPrefixDepth}</td20.cpuPrefixJvmArgument>
            </properties>
        </profile>
        <profile>
            <id>gpu</id>
            <build>
                <plugins>
                    <plugin>
                        <groupId>org.codehaus.mojo</groupId>
                        <artifactId>exec-maven-plugin</artifactId>
                        <executions>
                            <execution>
                                <id>cmake-configure</id>
                                <phase>generate-sources</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>cmake</executable>
                                    <arguments>
                                        <argument>-S</argument><argument>src/native</argument>
                                        <argument>-B</argument><argument>${project.build.directory}/native</argument>
                                        <argument>-DCMAKE_BUILD_TYPE=Release</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                            <execution>
                                <id>cmake-build</id>
                                <phase>compile</phase>
                                <goals><goal>exec</goal></goals>
                                <configuration>
                                    <executable>bash</executable>
                                    <arguments>
                                        <argument>-lc</argument>
                                        <argument>cmake --build &quot;${project.build.directory}/native&quot; --parallel &quot;$(nproc)&quot;</argument>
                                    </arguments>
                                </configuration>
                            </execution>
                        </executions>
                    </plugin>
                </plugins>
            </build>
        </profile>
    </profiles>
</project>
