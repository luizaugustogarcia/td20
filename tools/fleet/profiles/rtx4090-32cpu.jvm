# Unmeasured example for a different allocation: 32 CPU threads / one RTX 4090.
# Set the heap and queues for this server's actual RAM and free VRAM.
-R-Xms2g
-R-Xmx32g
-R-XX:ActiveProcessorCount=32
-R-XX:+UseG1GC
-R-XX:+ParallelRefProcEnabled
-R-XX:ParallelGCThreads=8
-R-XX:ConcGCThreads=2
-R-Dtd20.twistedBraceletWorkers=48
-R-Dtd20.gpuDevices=0
-R-Dtd20.gpuSlots=16
-R-Dtd20.gpuBudgetMB=768
-R-Dtd20.gpuQueueCapacity=16
-R-Dtd20.reconstructionGpuWorkers=48
-R-Dtd20.reconstructionInverseWorkers=32
-R-Dtd20.certificateWriters=8
-R-Dtd20.reconstructionWriters=4
-R-Dtd20.reconstructionBufferKeys=2097152
-R-Dtd20.reconstructionQueueBatches=256
-R-Dtd20.certificateQueueCapacity=131072
-R-Dtd20.certificateLookupBatchSize=16384
-R-Dtd20.reconstructionAdaptiveScan=true
-R-Dtd20.cpuPrefixMaxTriples=8192
-R-Dtd20.reconstructionCpuPrefixMillis=10
-R-Dtd20.reconstructionGpuMillis=0
