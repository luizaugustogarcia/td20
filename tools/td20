#!/usr/bin/env bash
set -euo pipefail
usage() {
    cat <<'USAGE'
Usage: tools/td20 [--dry-run] COMMAND [Java arguments or Maven build options]

CPU validation:
  test         Run both required CPU test suites
  inventory    Check the 83 root partitions and 143 endpoint annotations
  structure    Alias for inventory
  count        Check root and endpoint class counts on all available CPU cores
  count-roots  Regenerate and publish all active root U3,O3,C3 values; resumable
  count-endpoints  Persist the complete endpoint census via emitter JShell
  count-reconstruction  Count persisted budget-ten keys and save the completed-wave checkpoint
  audit-endpoints  Recount and compare endpoints via checker JShell
  endpoint-table  Write checked endpoint and root table totals into the paper
  census       Check root/endpoint counts via JShell
  audit-roots  Independently regenerate every root count via checker JShell
  audit-import  Independently replay copied TD18 results and check residual equality
  bench-permutations  Compare four small experimental primitive CPU populations
  bench-reconstruction  Compare experimental final-root closure strategies on read-only samples
  bench-reconstruction-long  Validate and time bounded source windows with residual persistence
  bench-inverse-gpu  Compare experimental CUDA inverse expansion with all-core Java

Computation:
  emit         Emit sorting results via JShell (build native CUDA first)
  avoidance    Reconstruct endpoint failures via JShell
  import-td18  Replay TD18 budget-nine results and seal second-level residuals
  fleet        Distribute emission and reconstruction over SSH; download and merge
  fleet-consolidate  Compact closed emission DBs remotely, then download large SSTs
  fleet-recover-emission  Regenerate a lost server's exact emission scope
  merge        Replay and merge certificate DBs into a fresh local database
  verify       Independently replay obligations via checker JShell

Build and help:
  build        Compile Java and prepare JShell classpaths
  build-gpu    Build CUDA (default SM 120) and package modules; prepare classpaths
  help         Show this help

Examples:
  tools/td20 count --phase=endpoints
  tools/td20 emit --phase=roots --partitions=1-1
  tools/td20 verify --phase=all
Supply application properties and JVM options as execution arguments, for example:
  tools/td20 verify -Dtd20.certificateReadWorkers=32 -R-Xmx24g
  tools/td20 verify '-Dexec.args=--phase=all -Dtd20.certificateEndpointFillCache=true'
Use --jvm-option=-XX:OPTION or -R-XX:OPTION for execution-VM options.
TD20_JSHELL_OPTIONS remains supported; command-line options take precedence.
Use tools/run-local-emitter.sh --build for the local SM 89 GPU build.
Use tools/run-local-{emitter,checker}.sh for the bounded local runtime profile.
Phases: roots, endpoints, avoidance, all (count supports roots/endpoints/all).
Ranges cover only their selected scope. Obstruction counts are not prerequisites.
The checker regenerates obligations and replays the certificate database directly.
Both direct arguments and -Dexec.args / -Dtd20.args syntax are supported.
See docs/WORKFLOW.md, docs/OPERATIONS.md, and docs/RESEARCH_PLAN.md.
Generated databases, reports, checkpoints, and ordinary logs remain untracked.
All generated execution logs and settings remain untracked.
USAGE
}
dry_run=false
if [[ ${1:-} == --dry-run ]]; then dry_run=true; shift; fi
command=${1:-help}
if (( $# > 0 )); then shift; fi
td20_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd -- "$td20_root"
case "$command" in
    help|--help|-h) usage; exit 0 ;;
    test)
        if "$dry_run"; then printf '%s\n' 'mvn -pl emitter -am test' 'mvn -pl checker -am test';
        else mvn -pl emitter -am test "$@"; mvn -pl checker -am test "$@"; fi
        exit ;;
    build|build-gpu)
        args=(-q -pl emitter,checker -am compile dependency:build-classpath -Dmdep.outputFile=target/jshell-classpath)
        if [[ $command == build-gpu ]]; then args=(-q -Pgpu package dependency:build-classpath -Dmdep.outputFile=target/jshell-classpath); fi
        if "$dry_run"; then printf '%q ' mvn "${args[@]}" "$@"; printf '\n';
        else exec mvn "${args[@]}" "$@"; fi
        exit ;;
esac
source "$td20_root/tools/launcher-options.sh"
expanded_arguments=()
td20_parse_words expanded_arguments arguments "$@"
set -- "${expanded_arguments[@]}"
module=emitter
script=
case "$command" in
    inventory|structure) module=checker; entry=br.unb.cic.td20.CertificateChecker; set -- --structural-only "$@" ;;
    verify) module=checker; entry=br.unb.cic.td20.CertificateChecker ;;
    count-roots) script=tools/audit/CountErikssonRoots.jsh ;;
    endpoint-table) script=tools/audit/WriteEndpointTable.jsh ;;
    count-endpoints) entry=br.unb.cic.td20.CountEriksson; set -- --phase=endpoints "$@" ;;
    audit-endpoints) module=checker; entry=br.unb.cic.td20.CountEriksson; set -- --phase=endpoints "$@" ;;
    audit-roots) module=checker; script=tools/audit/CountErikssonRoots.jsh ;;
    audit-import) module=checker; entry=br.unb.cic.td20.verification.ImportedTd18Verifier ;;
    bench-permutations) script=tools/bench/PrimitivePermutations.jsh ;;
    bench-reconstruction) script=tools/bench/ReconstructionAlternatives.jsh ;;
    bench-reconstruction-long) script=tools/bench/LongReconstruction.jsh ;;
    bench-inverse-gpu) script=tools/bench/InverseGpu.jsh ;;
    count|census) entry=br.unb.cic.td20.CountEriksson ;;
    count-reconstruction) entry=br.unb.cic.td20.avoidance.CountReconstructionWave ;;
    emit) entry=br.unb.cic.td20.WitnessEmitter ;;
    avoidance) entry=br.unb.cic.td20.WitnessEmitter; set -- --phase=avoidance "$@" ;;
    import-td18) entry=br.unb.cic.td20.avoidance.ImportTd18AfterTwo ;;
    fleet) entry=br.unb.cic.td20.fleet.FleetEmitter ;;
    fleet-worker) entry=br.unb.cic.td20.fleet.FleetWorker ;;
    fleet-hardware) entry=br.unb.cic.td20.fleet.FleetHardware ;;
    fleet-consolidate-worker) entry=br.unb.cic.td20.fleet.FleetConsolidationWorker ;;
    fleet-consolidate) entry=br.unb.cic.td20.fleet.FleetConsolidationBackup ;;
    fleet-recover-emission) entry=br.unb.cic.td20.fleet.FleetEmissionRecovery ;;
    merge) entry=br.unb.cic.td20.certificate.CertificateDatabaseMerger ;;
    *) printf 'Unknown command: %s\n' "$command" >&2; exit 2 ;;
esac
if [[ ! -f $module/target/jshell-classpath ]]; then
    if "$dry_run"; then printf '%s\n' '# Run tools/td20 build first.';
    else tools/td20 build; fi
fi
classpath="$td20_root/$module/target/classes"
if [[ -f $module/target/jshell-classpath ]]; then classpath+=":$(<"$module/target/jshell-classpath")"; fi
jshell_options=()
td20_parse_words jshell_options options "${TD20_JSHELL_OPTIONS:-}"
java_arguments=()
td20_collect_jvm_options jshell_options java_arguments "$@"
set -- "${java_arguments[@]}"
td20_add_numa_option jshell_options
if [[ $command == count-roots ]]; then jshell_options+=("-R-Dtd20.eriksson.publish=true"); fi
invocation=(jshell "-R-Dtd20.countModule=$module" --feedback concise --class-path "$classpath" "-R-Djava.library.path=$td20_root/emitter/target/native" "${jshell_options[@]}")
if "$dry_run"; then
    printf '%q ' "${invocation[@]}"
    if [[ -n $script ]]; then printf '%q\n' "$script"; else printf '%q ' "$entry" "$@"; printf '\n'; fi
    exit
fi
if [[ -n $script ]]; then
    if (( $# != 0 )); then printf '%s\n' 'This complete inventory command takes no range arguments.' >&2; exit 2; fi
    exec "${invocation[@]}" "$script"
fi
launch_tmp=${TD20_LAUNCH_TMPDIR:-${TMPDIR:-/tmp}}
mkdir -p -- "$launch_tmp"
driver=$(mktemp "$launch_tmp/td20-jshell-arguments-XXXXXX")
trap 'rm -f -- "$driver"' EXIT
printf '%s\0' "$entry" "$command" "$@" > "$driver"
export TD20_LAUNCH_ARGS="$driver"
"${invocation[@]}" tools/Launch.jsh
