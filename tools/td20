#!/usr/bin/env bash
set -euo pipefail
usage() {
    cat <<'USAGE'
Usage: tools/td20 [--dry-run] COMMAND [Java arguments or Maven build options]

CPU validation:
  test         Run both required CPU test suites
  inventory    Check the 83 root partitions and 143 endpoint annotations
  structure    Alias for inventory
  count        Check root and endpoint class counts on all available CPU cores
  count-roots  Regenerate and publish all active root U3,O3,C3 values; resumable
  count-endpoints  Persist the complete endpoint census via emitter JShell
  audit-endpoints  Recount and compare endpoints via checker JShell
  endpoint-table  Write checked endpoint and root table totals into the paper
  census       Check root/endpoint counts via JShell
  audit-roots  Independently regenerate every root count via checker JShell

Computation:
  emit         Emit sorting results via JShell (build-gpu first)
  avoidance    Reconstruct endpoint failures via JShell
  verify       Independently replay obligations via checker JShell

Build and help:
  build        Compile Java and prepare JShell classpaths
  build-gpu    Build CUDA and package both modules; prepare JShell classpaths
  help         Show this help

Examples:
  tools/td20 count --phase=endpoints
  tools/td20 emit --phase=roots --partitions=1-1
  tools/td20 verify --phase=all
Set TD20_JSHELL_OPTIONS for remote JVM options, for example:
  TD20_JSHELL_OPTIONS='-R-Dtd20.gpuSlots=2 -R-Dtd20.gpuBudgetMB=256'
Phases: roots, endpoints, avoidance, all (count supports roots/endpoints/all).
Ranges cover only their selected scope. Obstruction counts are not prerequisites.
The checker regenerates obligations and replays the certificate database directly.
Both direct arguments and -Dexec.args / -Dtd20.args syntax are supported.
See docs/WORKFLOW.md, docs/OPERATIONS.md, and docs/RESEARCH_PLAN.md.
Generated databases, reports, logs, and checkpoints remain untracked.
USAGE
}
dry_run=false
if [[ ${1:-} == --dry-run ]]; then dry_run=true; shift; fi
command=${1:-help}
if (( $# > 0 )); then shift; fi
td20_root=$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")/.." && pwd)
cd -- "$td20_root"
case "$command" in
    help|--help|-h) usage; exit 0 ;;
    test)
        if "$dry_run"; then printf '%s\n' 'mvn -pl emitter -am test' 'mvn -pl checker -am test';
        else mvn -pl emitter -am test "$@"; mvn -pl checker -am test "$@"; fi
        exit ;;
    build|build-gpu)
        args=(-q -pl emitter,checker -am compile dependency:build-classpath -Dmdep.outputFile=target/jshell-classpath)
        if [[ $command == build-gpu ]]; then args=(-q -Pgpu package dependency:build-classpath -Dmdep.outputFile=target/jshell-classpath); fi
        if "$dry_run"; then printf '%q ' mvn "${args[@]}" "$@"; printf '\n';
        else exec mvn "${args[@]}" "$@"; fi
        exit ;;
esac
module=emitter
script=
case "$command" in
    inventory|structure) module=checker; entry=br.unb.cic.td20.CertificateChecker; set -- --structural-only "$@" ;;
    verify) module=checker; entry=br.unb.cic.td20.CertificateChecker ;;
    count-roots) script=tools/audit/CountErikssonRoots.jsh ;;
    endpoint-table) script=tools/audit/WriteEndpointTable.jsh ;;
    count-endpoints) entry=br.unb.cic.td20.CountEriksson; set -- --phase=endpoints "$@" ;;
    audit-endpoints) module=checker; entry=br.unb.cic.td20.CountEriksson; set -- --phase=endpoints "$@" ;;
    audit-roots) module=checker; script=tools/audit/CountErikssonRoots.jsh ;;
    count|census) entry=br.unb.cic.td20.CountEriksson ;;
    emit) entry=br.unb.cic.td20.WitnessEmitter ;;
    avoidance) entry=br.unb.cic.td20.WitnessEmitter; set -- --phase=avoidance "$@" ;;
    *) printf 'Unknown command: %s\n' "$command" >&2; exit 2 ;;
esac
if [[ ! -f $module/target/jshell-classpath ]]; then
    if "$dry_run"; then printf '%s\n' '# Run tools/td20 build first.';
    else tools/td20 build; fi
fi
classpath="$td20_root/$module/target/classes"
if [[ -f $module/target/jshell-classpath ]]; then classpath+=":$(<"$module/target/jshell-classpath")"; fi
jshell_options=()
read -r -a jshell_options <<< "${TD20_JSHELL_OPTIONS:-}"
if [[ $command == count-roots ]]; then jshell_options+=("-R-Dtd20.eriksson.publish=true"); fi
invocation=(jshell "-R-Dtd20.countModule=$module" --feedback concise --class-path "$classpath" "-R-Djava.library.path=$td20_root/emitter/target/native" "${jshell_options[@]}")
if "$dry_run"; then
    printf '%q ' "${invocation[@]}"
    if [[ -n $script ]]; then printf '%q\n' "$script"; else printf '%q ' "$entry" "$@"; printf '\n'; fi
    exit
fi
if [[ -n $script ]]; then
    if (( $# != 0 )); then printf '%s\n' 'This complete inventory command takes no range arguments.' >&2; exit 2; fi
    exec "${invocation[@]}" "$script"
fi
mkdir -p "$module/target"
driver=$(mktemp "$module/target/jshell-driver-XXXXXX.jsh")
trap 'rm -f -- "$driver"' EXIT
python3 - "$entry" "$command" "$@" > "$driver" <<'PY'
import json, shlex, sys
entry, command = sys.argv[1:3]
arguments, properties = [], []
seen_args = False
for option in sys.argv[3:]:
    if option.startswith(('-Dexec.args=', '-Dtd20.args=')):
        if seen_args: raise SystemExit('Supply the Java argument property only once.')
        seen_args = True
        arguments.extend(shlex.split(option.split('=',1)[1]))
    elif option.startswith('-Dexec.mainClass='):
        entry = option.split('=',1)[1]
    elif option.startswith('-D'):
        key, sep, value = option[2:].partition('=')
        properties.append((key, value if sep else 'true'))
    elif option in ('-B','-q','-e','-X','-Pgpu'):
        continue
    else:
        arguments.append(option)
if command == 'avoidance' and any(a.startswith('--phase=') and a != '--phase=avoidance' for a in arguments):
    raise SystemExit('The avoidance command requires --phase=avoidance.')
print('int status=1;')
for key,value in properties:
    print('System.setProperty('+json.dumps(key)+','+json.dumps(value)+');')
args=','.join(json.dumps(arg,ensure_ascii=True) for arg in arguments)
print('try { '+entry+'.main(new String[]{'+args+'}); status=0; } catch(Throwable error) { error.printStackTrace(); status=1; }')
print('/exit status')
PY
"${invocation[@]}" "$driver"
